# =============================================================================
# ATLAS ASCEND — environment
# =============================================================================
# Copy to `.env.local` for development. Set the same values in Vercel under
# Project → Settings → Environment Variables (Production and Preview).
#
# `.env.local` is gitignored. Never commit a real value for anything here.
#
# THE ONE RULE THAT MATTERS:
#
#   `NEXT_PUBLIC_` is not a naming convention, it is a publication decision.
#   Next.js inlines any `NEXT_PUBLIC_*` variable into the JavaScript bundle it
#   sends to every visitor. Anything without that prefix stays on the server
#   and is readable only from route handlers and server components.
#
#   Exactly one variable here is public, and it is public by design. Adding a
#   `NEXT_PUBLIC_` prefix to any of the others would publish a paid API key to
#   the internet on the next deploy, silently and irreversibly.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the application reads this
# -----------------------------------------------------------------------------

# Mapbox public access token — must start with `pk.`
# Create one at https://account.mapbox.com/access-tokens/
#
# Read in exactly one place (`getPublicMapboxToken()` in src/lib/env.ts) and
# serves the browser map, server-side geocoding, and routing.
#
# A default Mapbox public token carries everything Atlas needs. Verify a given
# token from the deployment itself with the endpoint probe at `/debug/mapbox`,
# which requests every resource the app uses and prints Mapbox's own response —
# note that Mapbox answers an unrecognised credential and a genuinely
# under-scoped one with the same bare 401/403, so the probe reports what it was
# told rather than inferring which.
#
# URL restrictions are optional. Leave them off while getting started; if you
# add them later, the deployed production hostname must be listed.
#
# PUBLIC BY DESIGN: inlined into the browser bundle at BUILD time. Protect it
# with URL restrictions, not secrecy. Changing it requires a rebuild — not a
# restart, and not a redeploy of the same artifact.
#
# If unset, the app still builds and every route still serves; the map shows an
# explicit "MAP SERVICE NOT CONFIGURED" state and `/api/search` returns
# `503 {"failure":"not-configured"}` instead of crashing.
NEXT_PUBLIC_MAPBOX_TOKEN=


# -----------------------------------------------------------------------------
# PROVISIONED — nothing reads these yet
# -----------------------------------------------------------------------------
# Credentials for the Atlas intelligence and voice layers, configured ahead of
# the phase that will use them. No code in this repository reads any of them
# today, and their absence changes nothing about how the app builds or runs.
#
# They are documented here so the deployment contract is complete and so the
# server-only boundary is written down before the first line of code depends
# on it — not because a feature is waiting on them.
#
# SERVER-ONLY, ALL THREE. When they are eventually used it must be from a
# route handler or server component (the pattern `src/app/api/search/route.ts`
# already follows), never from a client component, and never through a value
# passed down into one. These are billed credentials; a leak is someone else's
# invoice.

# OpenAI API key — for the model-backed Atlas provider that will sit behind the
# existing `AtlasProvider` interface in src/atlas/types.ts.
OPENAI_API_KEY=

# ElevenLabs API key — for spoken Atlas guidance.
ELEVENLABS_API_KEY=

# ElevenLabs voice id — identifies the selected Atlas voice. Not a credential
# on its own, but kept server-side with the key it is meaningless without.
ELEVENLABS_VOICE_ID=
